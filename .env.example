# MANImation Studio configuration
# Copy to .env (`cp .env.example .env`) and fill in what you need.
# Real environment variables always win over values in this file.

# ── Claude (required unless MANIMATION_DEMO=1) ─────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Only needed for user-level keys that are not scoped to a workspace (id starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=

# ── Narration (text-to-speech) ─────────────────────────────────────────────
# deepgram | gtts (Google, free, no key) | silent
# Leave MANIMATION_TTS empty to pick automatically: deepgram if a key is set, else gtts.
MANIMATION_TTS=
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Deepgram Flux voice: flux-priya-en / flux-meena-en (Indian female), flux-naveen-en (Indian male), ...
# Full list: https://developers.deepgram.com/docs/flux-tts/voices
MANIMATION_TTS_VOICE=flux-priya-en

# ── Cost and quality ───────────────────────────────────────────────────────
# economy (Sonnet for every agent) | quality (Opus for Director and Fixer, ~2x price)
MANIMATION_PROFILE=economy
# Hard spending cap per video in USD; the run stops before exceeding it
MANIMATION_BUDGET_USD=0.75
# Maximum scenes the Director may plan per video
MANIMATION_MAX_SCENES=3
# Maximum edit/re-render turns the Fixer gets per scene
MANIMATION_FIXER_MAX_TURNS=8
# Seconds before a single Manim render is killed
MANIMATION_RENDER_TIMEOUT=240

# ── Runtime ────────────────────────────────────────────────────────────────
# 1 = demo mode: agents answer from the tested cookbook scenes, no API calls, no cost
MANIMATION_DEMO=0
# Where projects (storyboards, code, renders, videos) are stored; default ./data
# MANIMATION_DATA_DIR=./data

<mxfile host="drawio">
  <diagram id="pipeline" name="Pipeline">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="560" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Row 1: planning -->
        <mxCell id="p" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Why is the derivative&lt;br&gt;of x² equal to 2x?”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;1. Director&lt;/b&gt;&lt;br&gt;plans scenes, beats,&lt;br&gt;narration, colors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3F0FA;strokeColor=#1F6FA8;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;2. You review&lt;/b&gt;&lt;br&gt;edit the storyboard&lt;br&gt;before any code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF4D6;strokeColor=#B7791F;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="560" y="30" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="p" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="d" target="h"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Per-scene loop container -->
        <mxCell id="loop" value="for each scene" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#9CA3AF;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="170" width="880" height="285" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3. Coder&lt;/b&gt;&lt;br&gt;writes one Manim&lt;br&gt;file per scene" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3F0FA;strokeColor=#1F6FA8;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="215" width="190" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v" value="&lt;b&gt;4. Validator&lt;/b&gt;&lt;br&gt;checks code in ms,&lt;br&gt;auto-fixes (free)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="215" width="190" height="84" as="geometry" />
        </mxCell>
        <mxCell id="r" value="&lt;b&gt;5. Renderer&lt;/b&gt;&lt;br&gt;preview + layout&lt;br&gt;check (free)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="550" y="215" width="190" height="84" as="geometry" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;6. Fixer&lt;/b&gt; makes small edits,&lt;br&gt;like a code editor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3F0FA;strokeColor=#1F6FA8;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="c" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="v" target="r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="error" style="endArrow=block;endFill=1;html=1;strokeColor=#C2410C;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="r" target="f"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="re-check" style="endArrow=block;endFill=1;html=1;strokeColor=#C2410C;strokeWidth=2;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="f" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Down from review into the loop -->
        <mxCell id="e7" value="approve" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h" target="c">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="150" /><mxPoint x="145" y="150" /></Array></mxGeometry>
        </mxCell>

        <!-- Output column -->
        <mxCell id="n" value="&lt;b&gt;7. Narration&lt;/b&gt;&lt;br&gt;all lines in one voice&lt;br&gt;session (Deepgram)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F1EAFB;strokeColor=#6B46C1;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="960" y="215" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;8. Assembler&lt;/b&gt;&lt;br&gt;final narrated MP4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="960" y="360" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="clean" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r" target="n"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="n" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="l1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0FA;strokeColor=#1F6FA8;" vertex="1" parent="1"><mxGeometry x="20" y="485" width="22" height="16" as="geometry" /></mxCell>
        <mxCell id="l1t" value="AI agent (Claude)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="50" y="481" width="160" height="24" as="geometry" /></mxCell>
        <mxCell id="l2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="230" y="485" width="22" height="16" as="geometry" /></mxCell>
        <mxCell id="l2t" value="automatic step, no AI cost" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="260" y="481" width="220" height="24" as="geometry" /></mxCell>
        <mxCell id="l3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B7791F;" vertex="1" parent="1"><mxGeometry x="490" y="485" width="22" height="16" as="geometry" /></mxCell>
        <mxCell id="l3t" value="human in the loop" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="520" y="481" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="l4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFB;strokeColor=#6B46C1;" vertex="1" parent="1"><mxGeometry x="700" y="485" width="22" height="16" as="geometry" /></mxCell>
        <mxCell id="l4t" value="voice (text-to-speech)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="730" y="481" width="200" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

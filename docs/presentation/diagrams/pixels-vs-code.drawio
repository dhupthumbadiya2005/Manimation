        <mxCell id="b1" value="Prompt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="234" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Agents write&lt;br&gt;&lt;b&gt;Manim code&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E3F0FA;strokeColor=#1F6FA8;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="260" y="234" width="230" height="64" as="geometry" />

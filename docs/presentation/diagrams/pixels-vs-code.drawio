        <mxCell id="ea1" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="an" value="✗ equations and labels come out garbled&lt;br&gt;✗ cannot change one detail without regenerating&lt;br&gt;✗ nothing checks that the math is correct" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#9A3412;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="58" width="340" height="80" as="geometry" />

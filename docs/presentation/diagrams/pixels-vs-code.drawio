        <!-- Lane B: code-based -->
        <mxCell id="lb" value="MANImation Studio (code as the medium)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="40" y="188" width="560" height="34" as="geometry" />

        <mxCell id="b4" value="Video&lt;br&gt;+ source code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">

        <mxCell id="bn" value="✓ equations are typeset by LaTeX, always sharp&lt;br&gt;✓ fix one line, re-render one scene&lt;br&gt;✓ code is checked automatically before rendering" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#166534;spacingLeft=6;" vertex="1" parent="1">

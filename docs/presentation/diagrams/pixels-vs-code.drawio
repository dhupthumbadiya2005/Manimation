        <mxCell id="eb1" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="endArrow=block;endFill=1;html=1;strokeColor=#6B7280;strokeWidth=2;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>

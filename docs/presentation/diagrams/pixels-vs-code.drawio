<mxfile host="drawio">
  <diagram id="pixels-vs-code" name="Pixels vs code">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="520" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Lane A: AI video models -->
        <mxCell id="la" value="AI video generators (pixel models)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#9A3412;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="34" as="geometry" />

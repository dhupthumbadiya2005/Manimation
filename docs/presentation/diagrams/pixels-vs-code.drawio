        <mxCell id="b3" value="Manim renders&lt;br&gt;exact vectors + LaTeX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="560" y="234" width="190" height="64" as="geometry" />

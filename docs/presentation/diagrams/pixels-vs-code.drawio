        <mxCell id="a1" value="Prompt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Model predicts&lt;br&gt;&lt;b&gt;pixels&lt;/b&gt;, frame by frame" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FDECEC;strokeColor=#C2410C;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="260" y="66" width="230" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Video" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontFamily=Helvetica;fontSize=17;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="560" y="66" width="150" height="64" as="geometry" />
